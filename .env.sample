# Enezadocs production environment sample.
# Copy to `.env` and replace every placeholder before deploying:
#   cp .env.sample .env
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NOTE: this key also encrypts stored GitHub/MCP tokens; changing it makes
# existing encrypted values unreadable.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma-separated. Use explicit hosts in production, not *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated scheme+host origins, e.g. https://docs.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database selection
# DB_ENGINE=postgres -> uses DATABASE_URL below
# DB_ENGINE=sqlite   -> uses the local db.sqlite3 file (development only)
# ---------------------------------------------------------------------------
DB_ENGINE=postgres

# PostgreSQL connection URL. Inside docker-compose the host is the `db` service.
# NOTE: docker-compose builds this URL itself from POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DB, so keep the password below in sync with this placeholder.
DATABASE_URL=postgres://enezadocs:change-me-strong-password@db:5432/enezadocs

# Consumed by the postgres and web services in docker-compose. POSTGRES_PASSWORD is
# REQUIRED: docker-compose fails fast if it is unset.
POSTGRES_DB=enezadocs
POSTGRES_USER=enezadocs
# Set once before the first start and keep it stable across updates. PostgreSQL only
# applies this at first initialization of the `pgdata` volume; changing it later leaves
# the stored role password unchanged, so the app can no longer connect (the data stays
# intact). To change it, run inside the db container:
#   ALTER USER enezadocs WITH PASSWORD 'new-password';
POSTGRES_PASSWORD=change-me-strong-password

# SQLite example (development only):
# DB_ENGINE=sqlite
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Security (enable all of these behind HTTPS in production)
# ---------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
# Set to 1 only when running behind a trusted reverse proxy that sets
# X-Forwarded-Proto.
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=1

# ---------------------------------------------------------------------------
# Paths and storage
# ---------------------------------------------------------------------------
# Container paths; docker-compose mounts named volumes at these locations.
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
# Persistent FastEmbed model cache (avoids re-downloading on restart).
FASTEMBED_CACHE_PATH=/cache/fastembed

# ---------------------------------------------------------------------------
# Host port mapping for docker-compose
# ---------------------------------------------------------------------------
WEB_PORT=8000
UVICORN_WORKERS=3

# ---------------------------------------------------------------------------
# Authentication / SSO (optional)
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Read-only token used for GitHub documentation sources without a credential.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Bootstrap superuser (created after migrate when the username is absent)
# ---------------------------------------------------------------------------
# Leave blank to skip superuser creation.
DJANGO_SUPERUSER_USERNAME=example
DJANGO_SUPERUSER_EMAIL=example@example.com
DJANGO_SUPERUSER_PASSWORD=example-password

# ---------------------------------------------------------------------------
# Documentation search / cache
# ---------------------------------------------------------------------------
DOCS_CACHE_TREE_TTL=300
DOCS_CACHE_DOCUMENT_TTL=300
DOCS_CACHE_ASSET_TTL=900
DOCS_SEMANTIC_SEARCH_ENABLED=1
DOCS_SEMANTIC_LEXICAL_BACKEND=fts5
DOCS_SEMANTIC_EMBEDDINGS_BACKEND=fastembed
DOCS_SEMANTIC_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
DOCS_SEMANTIC_CHUNK_CHARS=1000
DOCS_SEMANTIC_CHUNK_OVERLAP=200
DOCS_SEMANTIC_RRF_K=60
DOCS_SEMANTIC_TOP_K=20

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
MCP_ENABLED=1
MCP_PATH=/mcp
MCP_MAX_CONTENT_CHARS=40000

# ---------------------------------------------------------------------------
# S3-compatible documentation storage (optional; leave blank to use LOCAL)
# When DOCS_S3_BUCKET is set, LOCAL sources read from this bucket.
# DOCS_S3_ACCESS_KEY_ID and DOCS_S3_SECRET_ACCESS_KEY must be provided together when the
# bucket is set (the app fails fast otherwise). Leave both blank to use the instance or
# default credential chain (e.g. an IAM role).
# ---------------------------------------------------------------------------
DOCS_S3_BUCKET=
DOCS_S3_PREFIX=
DOCS_S3_REGION=
DOCS_S3_ENDPOINT_URL=
DOCS_S3_ACCESS_KEY_ID=
DOCS_S3_SECRET_ACCESS_KEY=
DOCS_S3_USE_PATH_STYLE=0
